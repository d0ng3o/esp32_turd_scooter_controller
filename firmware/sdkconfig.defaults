# Target
CONFIG_IDF_TARGET="esp32c3"

# Console on the XIAO's native USB-Serial-JTAG. This frees UART1 (GPIO20/21,
# the D6/D7 bus pins) entirely for the one-wire motor-controller bus, and keeps
# logging/flashing over the USB-C connector.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# (leave the legacy UART console off)

# 4 MB flash with a dual-OTA partition table (OTA is a later phase, but the
# layout is in place now so enabling it later needs no re-partition/erase).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 1 kHz tick: clean 20 ms (50 Hz) poll cadence for the bus loop.
CONFIG_FREERTOS_HZ=1000

# Pack-voltage sense sits on GPIO5 = ADC2_CH0. On the ESP32-C3 the ADC2 one-shot
# driver is disabled by default (the ADC2 digital controller is marked unstable),
# so adc_oneshot_new_unit() returns ESP_ERR_NOT_SUPPORTED and the pack reads 0 V.
# We only ever sample the pack with the radio off (inputs_sample_pack is gated),
# so the Wi-Fi contention the erratum warns about doesn't apply here. Force it on.
CONFIG_ADC_ONESHOT_FORCE_USE_ADC2_ON_C3=y

# Compiler
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# LVGL fonts used on the OLED: 12 = bottom bar, 14 = top bar/icons,
# 36 = big speed / SoC readout.
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_36=y
