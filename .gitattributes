# Normalize text files to LF in the repo so shell scripts, the systemd unit, and
# C sources stay correct when checked out/built on Linux (ESP-IDF, the Pi logger).
* text=auto eol=lf

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.bin  binary
*.step binary
*.stp  binary
*.wrl  binary
*.zip  binary
