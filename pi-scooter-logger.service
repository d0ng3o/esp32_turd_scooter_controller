[Unit]
Description=Scooter one-wire bus ride logger
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /boot/firmware/pi_sniff.py --port /dev/serial0 --out /boot/firmware/rides --quiet
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
